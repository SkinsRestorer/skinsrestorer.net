    "@tanstack/react-hotkeys": "0.27.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/start-static-server-functions": "1.167.44",
    "@types/mdx": "^2.0.13",
    "@unpic/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "discord-api-types": "^0.38.55",
    "effect": "4.1.4",
