    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.156.0",
    "@unpic/placeholder": "^0.1.2",
    "@vitejs/plugin-react": "^6.2.1",
    "blurhash": "^2.0.5",
    "cf": "1.0.0-rc.1",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "fake-indexeddb": "^6.2.8",
    "knip": "6.35.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
