    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-timeago": "^8.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "seroval": "1.8.2",
    "skinview3d": "^3.4.1",
    "sonner": "^2.0.7",
    "takumi-js": "^2.13.7",
