{
  "name": "skinsrestorer.net",
  "version": "1.0.0",
  "description": "The code for our website and documentation!",
  "keywords": [],
  "license": "ISC",
  "author": "SRTeam",
  "type": "module",
  "scripts": {
    "dev": "bun run generate:images && cf dev",
    "build": "bun run generate:images && cf build",
    "start": "vite preview",
    "test": "bun test",
    "typecheck": "bun run cf-typegen && bun run generate:docs && bun run generate:routes && tsc --noEmit && tsc -p tsconfig.service-worker.json",
    "lint": "oxlint",
    "knip": "knip-bun",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "check": "bun run lint && bun run knip && bun run format:check && bun run i18n:check && bun run docs:check",
    "postinstall": "bun run generate:docs && bun run generate:routes",
    "docs:check": "bun scripts/check-docs.ts",
    "docs:java": "bun scripts/check-java-example.ts",
    "docs:upstream": "bun scripts/check-docs-upstream.ts",
    "preview": "vite preview",
    "generate:docs": "fumadocs-mdx",
    "generate:routes": "bun scripts/generate-routes.ts",
    "generate:images": "bun scripts/generate-images.ts",
    "test:site": "SITE_TEST_URL=http://localhost:3000 bun test scripts/site.test.ts",
    "deploy": "bun run generate:images && cf deploy",
    "deploy:check": "cf deploy --dry-run --prebuilt --mode production",
    "cf-typegen": "cf workers types",
    "i18n:check": "bun scripts/check-translations.ts",
    "prepare": "lefthook install && effect-tsgo patch --no-typescript --oxlint",
    "pre-commit": "lefthook run pre-commit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
