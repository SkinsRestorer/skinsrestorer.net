{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "fumadocs-mdx:collections/*": ["./.source/*"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".cloudflare/types/index.d.ts"],
  "exclude": ["node_modules", "dist", ".cloudflare/output"]
}
