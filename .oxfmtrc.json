{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "out",
    ".source",
    "**/*.md",
    "**/*.mdx",
    "src/routeTree.gen.ts",
    ".cloudflare"
  ]
}
