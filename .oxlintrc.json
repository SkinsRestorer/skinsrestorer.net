{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": [
    "react",
    "jsx-a11y",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "effecttsgo"
  ],
  "jsPlugins": ["@shadcn/lint", "eslint-plugin-better-tailwindcss"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    ".cloudflare/**",
    ".next/**",
    "next-env.d.ts"
  ],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/style.css"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": ["test", "describe", "it", "suite"],
            "package": "node:test"
          }
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "@fontsource-variable/*",
          "@/lib/analytics",
          "@/lib/stale-chunks"
        ]
      }
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/no-raw-colors": [
      "error",
      {
        "allow": [
          "bg-fd-accent",
          "bg-fd-card",
          "bg-fd-secondary",
          "text-fd-accent-foreground",
          "text-fd-foreground",
          "text-fd-muted-foreground",
          "text-fd-secondary-foreground"
        ]
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^Card$",
            "allow": [
              "layout",
              "hover:shadow-lg",
              "transition-shadow",
              "duration-200",
              "shadow-lg",
              "shadow-xl",
              "shadow-primary/5",
              "border-primary/50",
              "bg-background/80",
              "backdrop-blur-sm"
            ]
          },
          {
            "pattern": "^CardHeader$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardFooter$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardTitle$",
            "allow": ["layout", "text-lg", "text-xl"]
          },
          {
            "pattern": "^TabsContent$",
            "allow": ["layout", "text-xs", "text-muted-foreground"]
          },
          {
            "pattern": "^Button$",
            "allow": [
              "layout",
              "px-8",
              "text-lg",
              "font-semibold",
              "bg-background/80",
              "backdrop-blur-sm",
              "border-2",
              "text-muted-foreground"
            ]
          },
          {
            "pattern": "^AnimatedShinyText$",
            "allow": ["layout", "text-sm", "font-semibold"]
          },
          {
            "pattern": "^AccordionContent$",
            "allow": ["layout", "text-muted-foreground"]
          },
          {
            "pattern": "^HoverCardContent$",
            "allow": ["layout", "text-sm"]
          }
        ]
      }
    ],
    "shadcn/require-static-classes": "error",
    "shadcn/no-inline-styles": "error",
    "effecttsgo/any-unknown-in-error-context": "off",
    "effecttsgo/unsafe-effect-type-assertion": "off",
    "effecttsgo/strict-effect-provide": "off",
    "typescript/restrict-plus-operands": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": ["Redirect", "NotFoundError"]
          }
        ]
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-console": "error",
    "eslint/no-await-in-loop": "off",
    // Effect tags and TanStack Router splat params and history state keys.
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag", "_splat", "__TSR_index", "__TSR_key"]
      }
    ],
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    // The last then() in a chain has no consumer for its return value.
    "promise/always-return": [
      "error",
      {
        "ignoreLastCallback": true
      }
    ],
    "promise/catch-or-return": [
      "error",
      {
        "allowThen": true
      }
    ],
    "unicorn/prefer-at": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-top-level-await": "error",
    "react/jsx-no-target-blank": [
      "error",
      {
        "allowReferrer": true
      }
    ],
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-unknown-property": "error",
    "react/only-export-components": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/no-array-index-key": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-object-type-as-default-prop": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "eslint/no-useless-call": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": "only-allowed-literals"
      }
    ],
    // `||` between booleans is a logical or, not a default value.
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "boolean": true
        }
      }
    ],
    "typescript/require-await": "error",
    "typescript/no-non-null-assertion": "error",
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "error",
    "better-tailwindcss/no-deprecated-classes": "error",
    "better-tailwindcss/enforce-canonical-classes": "error"
  },
  "overrides": [
    {
      "files": ["src/lib/docs-og.tsx"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      // shadcn/ui primitives come from the registry. Fix consumers instead
      // of editing them (see AGENTS.md), so the stricter rules skip them.
      "files": ["src/components/ui/**"],
      "rules": {
        "better-tailwindcss/enforce-canonical-classes": "off",
        "better-tailwindcss/no-deprecated-classes": "off",
        "eslint/no-shadow": "off",
        "eslint/no-underscore-dangle": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/immutability": "off",
        "react/preserve-manual-memoization": "off",
        "react/purity": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "typescript/consistent-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "shadcn/no-unknown-classes": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-inline-styles": "off",
        "react/only-export-components": "off",
        "react/no-array-index-key": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/jsx-no-useless-fragment": "off",
        "typescript/consistent-type-imports": "off",
        "typescript/prefer-optional-chain": "off",
        "typescript/prefer-nullish-coalescing": "off",
        "typescript/no-unnecessary-condition": "off",
        "eslint/eqeqeq": "off"
      }
    },
    {
      // Build scripts, tests and tool configs report their results on the console.
      "files": ["scripts/**", "**/*.test.ts", "**/*.test.tsx", "*.config.ts"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      // The three.js viewers live in refs. `ready`, `attempt` and `failure`
      // say when a viewer was created or replaced, so effects list them to
      // apply settings to the new viewer, and a failed WebGL setup is state.
      "files": [
        "src/components/studio/skin-view.tsx",
        "src/components/editor/model-canvas.tsx"
      ],
      "rules": {
        "react/exhaustive-effect-dependencies": "off",
        "react/set-state-in-effect": "off"
      }
    },
    {
      // Route files export `Route` and keep their page components local. The
      // TanStack Router plugin splits those components out for Fast Refresh.
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
