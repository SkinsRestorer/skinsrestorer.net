/*
  X-DNS-Prefetch-Control: on
  X-XSS-Protection: 0
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff

/api/search
  Content-Type: application/json; charset=utf-8

/_images/*
  Cache-Control: public, max-age=31536000, immutable

/ru
  Content-Language: ru
/ru/*
  Content-Language: ru
/es
  Content-Language: es
/es/*
  Content-Language: es
/pt-BR
  Content-Language: pt-BR
/pt-BR/*
  Content-Language: pt-BR
