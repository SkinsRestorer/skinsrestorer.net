/*
  X-DNS-Prefetch-Control: on
  X-XSS-Protection: 0
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), hid=(), midi=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://t.skinsrestorer.net https://analytics.ahrefs.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://textures.minecraft.net https://cool-skins.skinsrestorer.net https://github.com https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' https://t.skinsrestorer.net https://eu.posthog.com https://analytics.ahrefs.com https://cloudflareinsights.com https://api.mineskin.org https://axolotl.skinsrestorer.net https://textures.minecraft.net https://cool-skins.skinsrestorer.net; frame-src https://ko-fi.com https://nowpayments.io; worker-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp-report; report-to csp
  Reporting-Endpoints: csp="/api/csp-report"

/api/search/*
  Content-Type: application/json; charset=utf-8
/api/docs-tree/*
  Content-Type: application/json; charset=utf-8

/_images/*
  Cache-Control: public, max-age=31536000, immutable

# Vite writes content-hashed JavaScript and CSS here (build.assetsDir).
/_build/*
  Cache-Control: public, max-age=31536000, immutable

# Prerendered HTML skips the worker middleware that sets Content-Language.
# Localized docs are left out: untranslated pages fall back to English, and
# their HTML lang attribute names the real language.
/
  Content-Language: en
/studio
  Content-Language: en
/upload
  Content-Language: en
/generator
  Content-Language: en
/pricing
  Content-Language: en
/privacy-policy
  Content-Language: en
/terms-of-service
  Content-Language: en
/cookie-policy
  Content-Language: en
/docs
  Content-Language: en
/docs/*
  Content-Language: en
/ru
  Content-Language: ru
/ru/studio
  Content-Language: ru
/ru/upload
  Content-Language: ru
/ru/generator
  Content-Language: ru
/ru/pricing
  Content-Language: ru
/es
  Content-Language: es
/es/studio
  Content-Language: es
/es/upload
  Content-Language: es
/es/generator
  Content-Language: es
/es/pricing
  Content-Language: es
/pt-BR
  Content-Language: pt-BR
/pt-BR/studio
  Content-Language: pt-BR
/pt-BR/upload
  Content-Language: pt-BR
/pt-BR/generator
  Content-Language: pt-BR
/pt-BR/pricing
  Content-Language: pt-BR
